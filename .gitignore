# =========================================================
# Python
# =========================================================

__pycache__/
*.py[cod]
*.pyo
*.egg-info/

# Virtual environments
venv/
.venv/
env/
Backend/venv/
Backend/.venv/

# =========================================================
# Datasets
# =========================================================

# Raw / cleaned / processed image datasets
Backend/data/raw/*
Backend/data/cleaned/*
Backend/data/processed/*

# Generated dataset reports
Backend/data/reports/*.json
Backend/data/reports/*.txt
Backend/data/reports/*.csv

# =========================================================
# Dataset split manifests
# =========================================================

# Keep the split CSV files available to the team.
# Actual image datasets remain ignored.
!Backend/data/splits/
!Backend/data/splits/*.csv
!Backend/data/splits/.gitkeep

# =========================================================
# Model artifacts
# =========================================================

Backend/models/*.pt
Backend/models/*.pth
Backend/models/*.ckpt
Backend/models/*.json

# Experiment / generated reports
Backend/reports/*.csv
Backend/reports/*.json
Backend/reports/evaluation/
Backend/ml/checkpoints/
Backend/ml/artifacts/

